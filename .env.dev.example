# ACRN Adjudication -- DEV environment
# Copy this file to .env.dev and fill in real values. Never commit .env.dev.

APP_PORT=8005

# External dev Postgres (ACRN-managed). SSL is required.
DB_NAME=acrn_adjudication
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_HOST=DEV_DB_HOST
DB_PORT=5432
DB_SSL_MODE=require

# Reserved for future use — not currently consumed by the backend.
SECRET_KEY=change-me-dev-secret
OPENAI_API_KEY=

SESSION_HOURS=12
LOGIN_LOCK_AFTER=5
LOGIN_LOCK_MINUTES=15

DEMO_DEFAULT_PASSWORD=ACRN@2026
DEMO_FORCE_PASSWORD_CHANGE=true

RT_PSEUDONYM_SECRET=change-me-dev-pseudonym-secret
RT_IDENTITY_ENCRYPTION_KEY=

# Microsoft Entra ID SSO (see docs/entra-sso-setup.md for how to obtain these)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
APP_BASE_URL=https://adjudication-dev.acrncloud.com
