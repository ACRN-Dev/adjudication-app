# ACRN Adjudication -- PRODUCTION environment
# Copy this file to .env.prod and fill in real values. Never commit .env.prod.
# Every setting below is required: ./scripts/init-prod.sh refuses to deploy if any is
# left empty or still holding one of the placeholder values shown here.

APP_PORT=8005

# External production Postgres (ACRN-managed). SSL is required.
DB_NAME=acrn_adjudication
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_HOST=PROD_DB_HOST
DB_PORT=5432
DB_SSL_MODE=require

# Reserved for future use — not currently consumed by the backend.
SECRET_KEY=
OPENAI_API_KEY=

SESSION_HOURS=12
SESSION_IDLE_MINUTES=30
LOGIN_LOCK_AFTER=5
LOGIN_LOCK_MINUTES=15

# RealTime longitudinal identity protection. Both values are required for every
# production startup so an import can never use repository fallback material.
#
# RT_PSEUDONYM_SECRET keys the HMAC that turns MRN + screening number into a participant
# pseudonym; RT_IDENTITY_ENCRYPTION_KEY encrypts the restricted identity crosswalk. Left
# blank, production startup is refused.
#
# They determine every pseudonym, so rotation requires a controlled re-key procedure.
# Generate once and store in the approved secret vault.
#   RT_PSEUDONYM_SECRET:        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   RT_IDENTITY_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RT_PSEUDONYM_SECRET=
RT_IDENTITY_ENCRYPTION_KEY=

# Microsoft Entra ID SSO (see docs/entra-sso-setup.md for how to obtain these).
# Use the PROD App Registration, whose redirect URI is
# https://adjudication.acrncloud.com/api/auth/sso/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
APP_BASE_URL=https://adjudication.acrncloud.com
METRICS_BEARER_TOKEN=

# Shared database-backed request limits. Tune only through a controlled change.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_UPLOAD=12
RATE_LIMIT_SIGNATURE=30
RATE_LIMIT_EXPORT=20
RATE_LIMIT_CLINICAL_WRITE=60
RATE_LIMIT_ADMIN_WRITE=60

# Do NOT set ENABLE_DEMO_ACCOUNTS here. docker-compose.prod.yml pins it to false, and
# init-prod.sh aborts if this file tries to turn it on. With it off, demo credentials and
# header-based authentication are unavailable; only SSO and administrator-provisioned users work.
#
# Set ENABLE_DEMO_DATA=true only for a dedicated hosted demonstration environment. It enables
# resettable synthetic Admin Portal data for authenticated administrators without enabling demo
# accounts. Leave it unset or false for live clinical production.
ENABLE_DEMO_DATA=false
ENABLE_LEGACY_UNSAFE_ROUTES=false
# Signed case output: Microsoft Graph / SharePoint document library
ETMF_ADAPTER=sharepoint
ETMF_SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/clinical-etmf
ETMF_SHAREPOINT_LIBRARY=Adjudication Records
AZURE_TENANT_ID=replace-with-tenant-id
AZURE_CLIENT_ID=replace-with-app-client-id
AZURE_CLIENT_SECRET=replace-with-secret-from-managed-secret-store
