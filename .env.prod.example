# ACRN Adjudication -- PRODUCTION environment
# Copy this file to .env.prod and fill in real values. Never commit .env.prod.
# Every setting below is required: ./scripts/init-prod.sh refuses to deploy if any is
# left empty or still holding one of the placeholder values shown here.

APP_PORT=8005

# External production Postgres (ACRN-managed). SSL is required.
DB_NAME=acrn_adjudication
DB_USER=USERNAME
DB_PASSWORD=PASSWORD
DB_HOST=PROD_DB_HOST
DB_PORT=5432
DB_SSL_MODE=require

# Reserved for future use — not currently consumed by the backend.
SECRET_KEY=
OPENAI_API_KEY=

SESSION_HOURS=12
LOGIN_LOCK_AFTER=5
LOGIN_LOCK_MINUTES=15

# RealTime longitudinal identity protection. REQUIRED IN PRODUCTION.
# RT_PSEUDONYM_SECRET keys the HMAC that turns MRN + screening number into a participant
# pseudonym; RT_IDENTITY_ENCRYPTION_KEY encrypts the restricted identity crosswalk.
# If either is left blank the backend silently falls back to a publicly known demo value,
# which would make production pseudonyms reversible by anyone with the source code.
# Generate them once, store them in the approved secret vault, and never rotate without a
# migration plan — changing them orphans every existing pseudonym and crosswalk row.
#   RT_PSEUDONYM_SECRET:        python -c "import secrets; print(secrets.token_urlsafe(48))"
#   RT_IDENTITY_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RT_PSEUDONYM_SECRET=
RT_IDENTITY_ENCRYPTION_KEY=

# Microsoft Entra ID SSO (see docs/entra-sso-setup.md for how to obtain these).
# Use the PROD App Registration, whose redirect URI is
# https://adjudication.acrncloud.com/api/auth/sso/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
APP_BASE_URL=https://adjudication.acrncloud.com

# Do NOT set ENABLE_DEMO_ACCOUNTS here. docker-compose.prod.yml pins it to false, and
# init-prod.sh aborts if this file tries to turn it on. With it off, no demo account and
# no synthetic Admin Portal fixture is ever written to the production database.
